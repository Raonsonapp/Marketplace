# TajikShop API — Hugging Face Spaces (Docker SDK) deployment.
#
# This file (plus README.md in this directory) IS pushed as the ROOT of a
# dedicated Hugging Face Space git repo by
# .github/workflows/deploy-huggingface.yml on every relevant change — HF
# Spaces only build from files living at the Space repo's root, and this
# monorepo's backend lives under services/api, so the Space repo is a thin
# shell that clones the real source at build time. See
# docs/HUGGINGFACE_DEPLOYMENT.md for the full picture (first-time setup,
# secrets, what the CI job actually does).
#
# Do not edit this file directly on huggingface.co — it gets overwritten by
# the next automated deploy. Edit it here and push to main instead.

FROM golang:1.25-bookworm AS build

# The CI job replaces "dev" with the deploying commit's SHA before pushing
# this file to the Space, so this RUN instruction's text is different on
# every deploy — which is what forces Docker to actually re-run it instead
# of reusing a cached layer from a previous (older) commit.
ARG SOURCE_COMMIT=dev

WORKDIR /src
RUN echo "Building services/api from commit ${SOURCE_COMMIT}" && \
    git clone --depth 1 https://github.com/Raonsonapp/Marketplace.git .

WORKDIR /src/services/api
RUN go mod download
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/tajikshop-api ./cmd/server

FROM gcr.io/distroless/static-debian12:nonroot AS runtime

WORKDIR /app
COPY --from=build /out/tajikshop-api /app/tajikshop-api

USER nonroot:nonroot
# Hugging Face Spaces (Docker SDK) route traffic to port 7860 by default.
ENV PORT=7860
EXPOSE 7860

ENTRYPOINT ["/app/tajikshop-api"]
