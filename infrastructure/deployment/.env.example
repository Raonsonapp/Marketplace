# TajikShop — example environment variables.
# Copy to .env for local development. NEVER commit a real .env file.

# ---------- API server ----------
PORT=8080
ENV=local

# ---------- Database ----------
DATABASE_URL=postgres://tajikshop:tajikshop@postgres:5432/tajikshop?sslmode=disable
POSTGRES_USER=tajikshop
POSTGRES_PASSWORD=tajikshop
POSTGRES_DB=tajikshop

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0

# ---------- Auth / JWT ----------
# HS256 signing secret for access/refresh tokens. Generate a strong random
# value per environment, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-in-every-real-environment
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ---------- Object storage (S3-compatible: MinIO locally, R2/Supabase in prod) ----------
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=tajikshop-media
OBJECT_STORAGE_ACCESS_KEY=tajikshop
OBJECT_STORAGE_SECRET_KEY=tajikshop-secret
OBJECT_STORAGE_USE_PATH_STYLE=true

# ---------- SMS / OTP delivery ----------
# "console" logs the OTP code instead of sending an SMS (local/dev only).
# Swap to a real provider identifier once one is integrated for production.
SMS_PROVIDER=console

# Telegram Gateway — RECOMMENDED real SMS delivery for the console-OTP flow
# (send-otp/verify-otp), free of any billing account. See
# docs/SMS_PROVIDERS.md. Get a token from https://gateway.telegram.org
# (Account -> API access). Leave empty to keep logging OTP codes to the
# console (local dev).
TELEGRAM_GATEWAY_TOKEN=

# Firebase Phone Auth — an alternative real-SMS registration path (see
# docs/FIREBASE_SETUP.md), requires a Google Cloud Blaze (billing) account
# even though usage typically stays within the free quota. The backend only
# verifies the resulting ID token, so it needs the Firebase project's Web
# API Key (Project settings -> General in the Firebase console — not a
# secret service-account key). Leave empty to disable; POST
# /auth/firebase-verify then returns FIREBASE_NOT_CONFIGURED.
FIREBASE_WEB_API_KEY=

# ---------- Push notifications (Firebase Cloud Messaging) ----------
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON_BASE64=

# ---------- Google Sign-In (optional) ----------
GOOGLE_OAUTH_CLIENT_ID=

# ---------- CORS ----------
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------- Android release signing (CI only, never local) ----------
ANDROID_KEYSTORE_BASE64=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
