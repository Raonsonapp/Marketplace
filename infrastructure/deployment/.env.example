# TajikShop — example environment variables.
# Copy to .env for local development. NEVER commit a real .env file.

# ---------- API server ----------
PORT=8080
ENV=local

# ---------- Database ----------
DATABASE_URL=postgres://tajikshop:tajikshop@postgres:5432/tajikshop?sslmode=disable
POSTGRES_USER=tajikshop
POSTGRES_PASSWORD=tajikshop
POSTGRES_DB=tajikshop

# ---------- Redis ----------
# Optional: leave empty to run against an in-process, in-memory
# Redis-compatible server instead (fine for a single-instance deployment;
# data does not survive a restart and isn't shared across replicas — set a
# real REDIS_URL, e.g. a free Upstash database, once that matters).
REDIS_URL=redis://redis:6379/0

# ---------- Auth / JWT ----------
# HS256 signing secret for access/refresh tokens. Generate a strong random
# value per environment, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-in-every-real-environment
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ---------- Object storage (S3-compatible: MinIO locally, Cloudflare R2 in
# prod) — powers POST /api/v1/uploads/presign (review images, support-chat
# attachments). Leave the bucket/keys empty to disable; that endpoint then
# returns UPLOADS_NOT_CONFIGURED instead of failing unpredictably.
#
# These exact CF_* variable names match the secrets already configured on
# this account's Hugging Face Spaces, so an existing Space's R2 secrets
# work here unchanged.
CF_R2_ACCESS_KEY_ID=tajikshop
CF_R2_SECRET_ACCESS_KEY=tajikshop-secret
CF_R2_BUCKET=tajikshop-media
# Base URL objects are publicly reachable at once uploaded — R2's public
# dev URL (https://<id>.r2.dev) or a custom domain attached to the bucket;
# for local MinIO this is the same host as R2_ENDPOINT below plus bucket.
CF_R2_PUBLIC_URL=http://localhost:9000/tajikshop-media

# Production (Cloudflare R2): set this instead of R2_ENDPOINT below — the
# R2 S3 API endpoint (https://<account>.r2.cloudflarestorage.com) is
# derived from it automatically.
CF_ACCOUNT_ID=

# Local dev (docker-compose MinIO) only: overrides the CF_ACCOUNT_ID-derived
# endpoint with a plain host:port. Leave unset in production.
R2_ENDPOINT=minio:9000

# ---------- SMS / OTP delivery ----------
# "console" logs the OTP code instead of sending an SMS (local/dev only).
# Swap to a real provider identifier once one is integrated for production.
SMS_PROVIDER=console

# Telegram bot — deliver OTP codes as a message from your own bot (made via
# @BotFather), no Telegram Gateway business signup needed. Takes priority
# over TELEGRAM_GATEWAY_TOKEN below when both are set. See
# docs/SMS_PROVIDERS.md — the user must open the bot and press Start once
# before their first code can be delivered.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Optional: your own numeric Telegram chat id. When set, the bot above (so
# TELEGRAM_BOT_TOKEN must also be set) pings this chat with a summary + KYC
# document links every time someone submits a "become a seller" application
# (POST /seller-applications) — a free stand-in for an email/admin-panel
# notification. To find your chat id: message the bot once yourself, then
# open https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/getUpdates and read
# "chat":{"id": ...} from the response.
TELEGRAM_ADMIN_CHAT_ID=

# Telegram Gateway — an alternative real SMS delivery path for the
# console-OTP flow (send-otp/verify-otp), free of any billing account, that
# doesn't need the user to open a bot first — but needs a separate signup at
# https://gateway.telegram.org (Account -> API access), a different token
# format than a bot's. See docs/SMS_PROVIDERS.md. Leave both this and
# TELEGRAM_BOT_TOKEN empty to keep logging OTP codes to the console (local
# dev).
TELEGRAM_GATEWAY_TOKEN=

# If the backend's host can't open a TLS connection to Telegram at all
# (observed on Hugging Face Spaces: every send-otp call fails with
# "net/http: TLS handshake timeout", regardless of timeout length — a
# network-level block, not slowness), route Telegram Gateway calls through
# a Google Apps Script relay instead. See docs/TELEGRAM_RELAY_SETUP.md.
# Leave both empty to call gatewayapi.telegram.org directly (default).
TELEGRAM_GATEWAY_PROXY_URL=
TELEGRAM_GATEWAY_PROXY_SECRET=

# Firebase Phone Auth — an alternative real-SMS registration path (see
# docs/FIREBASE_SETUP.md), requires a Google Cloud Blaze (billing) account
# even though usage typically stays within the free quota. The backend only
# verifies the resulting ID token, so it needs the Firebase project's Web
# API Key (Project settings -> General in the Firebase console — not a
# secret service-account key). Leave empty to disable; POST
# /auth/firebase-verify then returns FIREBASE_NOT_CONFIGURED.
FIREBASE_WEB_API_KEY=

# ---------- Push notifications (Firebase Cloud Messaging) ----------
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON_BASE64=

# ---------- Google Sign-In (optional) ----------
GOOGLE_OAUTH_CLIENT_ID=

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:5173

# ---------- Android release signing (CI only, never local) ----------
ANDROID_KEYSTORE_BASE64=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
